+// so an alias for "recipe" cannot capture "recipe_backup".
+auto MostSpecificLink(const std::unordered_map<std::string, std::string>& links,
+                      std::string_view path) {
+  auto best = links.cend();
+  for (auto it = links.cbegin(); it != links.cend(); ++it) {
+    const auto& prefix = it->first;
+    if (prefix.empty() || !rex::string::utf8_starts_with_case(path, prefix)) continue;
