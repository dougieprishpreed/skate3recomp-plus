+// Reports when each new guest frame's paint has finished on the GPU, the
+// D3D12 counterpart of VulkanPresenter::ReadyObserver: the guest frame pacer
+// phase-locks mailbox presentation to the display with it.
+struct D3D12Presenter::ReadyObserver {
+  static constexpr size_t kMaxPending = 4;
+
+  explicit ReadyObserver(ID3D12Device* device) {
+    if (FAILED(device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&fence_)))) {
+      return;
+    }
+    event_ = CreateEvent(nullptr, FALSE, FALSE, nullptr);
+    if (!event_) {
+      fence_.Reset();
+      return;
+    }
+    thread_ = std::thread([this] { Run(); });
+  }
+
+  ~ReadyObserver() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      stop_ = true;
+    }
+    cv_.notify_all();
+    if (thread_.joinable()) {
+      thread_.join();
+    }
+    // A queued signal must land before its fence goes.
+    if (fence_ && fence_->GetCompletedValue() < last_value_ &&
+        SUCCEEDED(fence_->SetEventOnCompletion(last_value_, event_))) {
+      WaitForSingleObject(event_, 1000);
+    }
+    if (event_) {
+      CloseHandle(event_);
+    }
+  }
+
+  // Painting thread: signals once everything submitted before it (the paint
+  // and the present) has finished. Skipped (the frame goes unobserved) while
+  // kMaxPending signals are outstanding.
+  void Observe(ID3D12CommandQueue* queue) {
+    if (!fence_) {
+      return;
+    }
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (pending_.size() >= kMaxPending) {
+        return;
+      }
+    }
+    if (FAILED(queue->Signal(fence_.Get(), last_value_ + 1))) {
+      return;
+    }
+    ++last_value_;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      pending_.push_back(last_value_);
+    }
+    cv_.notify_one();
+  }
+
+ private:
+  void Run() {
+    while (true) {
+      UINT64 value;
+      {
+        std::unique_lock<std::mutex> lock(mutex_);
+        cv_.wait(lock, [this] { return stop_ || !pending_.empty(); });
+        if (stop_) {
+          return;
+        }
+        value = pending_.front();
+      }
+      if (fence_->GetCompletedValue() < value) {
+        if (FAILED(fence_->SetEventOnCompletion(value, event_))) {
+          return;  // device removed: no more feedback
+        }
+        if (WaitForSingleObject(event_, 1000) != WAIT_OBJECT_0) {
+          continue;  // still pending: look again (and at stop_)
+        }
+      }
+      PublishGuestFrameReady(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                 std::chrono::steady_clock::now().time_since_epoch())
+                                 .count());
+      std::lock_guard<std::mutex> lock(mutex_);
+      pending_.pop_front();
+    }
+  }
+
+  Microsoft::WRL::ComPtr<ID3D12Fence> fence_;
+  HANDLE event_ = nullptr;
+  UINT64 last_value_ = 0;  // painting thread only
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  std::deque<UINT64> pending_;
+  bool stop_ = false;
+  std::thread thread_;
+};
