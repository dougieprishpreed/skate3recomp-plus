+        prefix.back() == '\\' || prefix.back() == '/' ||
+        path[prefix.size()] == '\\' || path[prefix.size()] == '/';
+    if (boundary && (best == links.cend() || prefix.size() > best->first.size())) best = it;
+  }
+  return best;
