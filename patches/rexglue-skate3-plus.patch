+// See Presenter::GetHostPresentSync: written by the UI thread when the surface
+// paint connection changes, read by the guest output thread and the guest
+// frame pacer.
+std::atomic<uint8_t> g_host_present_sync{0};
+// See Presenter::LastGuestFrameReady: seqlock-style pair (odd sequence =
+// write in progress), one writer (the readiness observer).
+std::atomic<uint64_t> g_guest_frame_ready_seq{0};
+std::atomic<int64_t> g_guest_frame_ready_ns{0};
+
 }  // namespace
 
 namespace rex {
 namespace ui {
 
+Presenter::HostPresentSync Presenter::GetHostPresentSync() {
+  return HostPresentSync(g_host_present_sync.load(std::memory_order_relaxed));
+}
+
+void Presenter::SetHostPresentSync(HostPresentSync sync) {
+  g_host_present_sync.store(uint8_t(sync), std::memory_order_relaxed);
+}
+
+void Presenter::PublishGuestFrameReady(int64_t ready_ns) {
+  const uint64_t seq = g_guest_frame_ready_seq.load(std::memory_order_relaxed);
+  g_guest_frame_ready_seq.store(seq + 1, std::memory_order_relaxed);
+  std::atomic_thread_fence(std::memory_order_release);
+  g_guest_frame_ready_ns.store(ready_ns, std::memory_order_relaxed);
+  g_guest_frame_ready_seq.store(seq + 2, std::memory_order_release);
+}
+
+uint64_t Presenter::LastGuestFrameReady(int64_t* ready_ns) {
+  while (true) {
+    const uint64_t seq = g_guest_frame_ready_seq.load(std::memory_order_acquire);
+    const int64_t ns = g_guest_frame_ready_ns.load(std::memory_order_relaxed);
+    std::atomic_thread_fence(std::memory_order_acquire);
+    if ((seq & 1) == 0 && g_guest_frame_ready_seq.load(std::memory_order_relaxed) == seq) {
+      *ready_ns = ns;
+      return seq / 2;
+    }
+  }
+}
