+// file (every cvar config) is written key by key here instead: floats as
+// FormatConfigDouble, everything else through toml++'s own formatter.
+void WriteConfigTable(std::ostream& out, const toml::table& config) {
+  for (auto&& [key, node] : config) {
+    if (!IsBareConfigKey(key.str()) || node.is_table() || node.is_array()) {
+      out << config;  // nested layouts keep toml++'s formatting
+      return;
+    }
+  }
+  for (auto&& [key, node] : config) {
+    out << key.str() << " = ";
+    if (const auto* value = node.as_floating_point()) {
+      out << FormatConfigDouble(value->get());
+    } else {
+      out << toml::toml_formatter{node};
+    }
+    out << '\n';
+  }
+}
