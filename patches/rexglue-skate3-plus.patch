+struct VulkanPresenter::ReadyObserver {
+  static constexpr uint32_t kFenceCount = 4;
+
+  explicit ReadyObserver(const VulkanDevice* device) : device_(device) {
+    const VulkanDevice::Functions& dfn = device_->functions();
+    VkFenceCreateInfo fence_create_info = {};
+    fence_create_info.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+    for (uint32_t i = 0; i < kFenceCount; ++i) {
+      if (dfn.vkCreateFence(device_->device(), &fence_create_info, nullptr, &fences_[i]) ==
+          VK_SUCCESS) {
+        free_mask_ |= uint32_t(1) << i;
+      }
+    }
+    thread_ = std::thread([this] { Run(); });
+  }
+
+  ~ReadyObserver() {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      stop_ = true;
+    }
+    cv_.notify_all();
+    thread_.join();
+    const VulkanDevice::Functions& dfn = device_->functions();
+    // Submitted signals still pending must land before their fences go.
+    for (uint32_t index : pending_) {
+      dfn.vkWaitForFences(device_->device(), 1, &fences_[index], VK_TRUE, 1'000'000'000ull);
+    }
+    for (VkFence fence : fences_) {
+      if (fence != VK_NULL_HANDLE) {
+        dfn.vkDestroyFence(device_->device(), fence, nullptr);
+      }
+    }
+  }
+
+  // Painting thread: queues an empty submission that signals a fence once
+  // everything submitted before it has finished on the GPU. Skipped (the
+  // frame goes unobserved) when the observer still holds every fence.
+  void Observe(VkQueue queue) {
+    uint32_t index;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (free_mask_ == 0) {
+        return;
+      }
+      index = uint32_t(std::countr_zero(free_mask_));
+      free_mask_ &= ~(uint32_t(1) << index);
+    }
+    const bool submitted = device_->functions().vkQueueSubmit(queue, 0, nullptr,
+                                                              fences_[index]) == VK_SUCCESS;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (submitted) {
+        pending_.push_back(index);
+      } else {
+        free_mask_ |= uint32_t(1) << index;
+      }
+    }
+    if (submitted) {
+      cv_.notify_one();
+    }
+  }
+
+ private:
+  void Run() {
+    const VulkanDevice::Functions& dfn = device_->functions();
+    while (true) {
+      uint32_t index;
+      {
+        std::unique_lock<std::mutex> lock(mutex_);
+        cv_.wait(lock, [this] { return stop_ || !pending_.empty(); });
+        if (stop_) {
+          return;
+        }
+        index = pending_.front();
+        pending_.pop_front();
+      }
+      const VkResult result =
+          dfn.vkWaitForFences(device_->device(), 1, &fences_[index], VK_TRUE, 1'000'000'000ull);
+      if (result == VK_SUCCESS) {
+        PublishGuestFrameReady(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                   std::chrono::steady_clock::now().time_since_epoch())
+                                   .count());
+        dfn.vkResetFences(device_->device(), 1, &fences_[index]);
+      }
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (result == VK_SUCCESS) {
+        free_mask_ |= uint32_t(1) << index;
+      } else if (result == VK_TIMEOUT) {
+        // Still pending: keep it out of use rather than resetting it under a
+        // queued submission, and look again.
+        pending_.push_back(index);
+      }
+      // Device loss: the fence stays retired.
+    }
+  }
+
+  const VulkanDevice* device_;
+  VkFence fences_[kFenceCount] = {};
+  std::mutex mutex_;
+  std::condition_variable cv_;
+  std::deque<uint32_t> pending_;
+  uint32_t free_mask_ = 0;
+  bool stop_ = false;
+  std::thread thread_;
+};
+
+void VulkanPresenter::ReadyObserverDeleter::operator()(ReadyObserver* observer) const {
+  delete observer;
+}
