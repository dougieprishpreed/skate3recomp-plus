+// Convert the captured world direction before enabling Custom. Reject invalid
+// input rather than replacing a user's existing angles with a fabricated sun.
+bool SunAnglesFromDirection(const float* dir, float& azimuth, float& elevation) {
+  if (!std::isfinite(dir[0]) || !std::isfinite(dir[1]) || !std::isfinite(dir[2])) return false;
+  const double length = std::sqrt(double(dir[0]) * dir[0] + double(dir[1]) * dir[1] +
+                                  double(dir[2]) * dir[2]);
+  if (length < 1e-6) return false;
+  constexpr double kRad = 57.29577951308232;
+  azimuth = float(std::fmod(std::atan2(double(dir[0]), double(dir[2])) * kRad + 360.0, 360.0));
+  elevation = float(std::clamp(std::asin(std::clamp(double(dir[1]) / length, -1.0, 1.0)) *
+                               kRad, 2.0, 88.0));
+  return true;
+}
