+// The shortest text that reads back as the same double through toml++'s
+// float parser (a classic-locale stream wherever TOML_FLOAT_CHARCONV is off).
+std::string FormatConfigDouble(double value) {
+  if (!std::isfinite(value)) {
+    return std::isnan(value) ? "nan" : (value < 0 ? "-inf" : "inf");
+  }
+  std::string text;
+  for (int precision = 15; precision <= 17; ++precision) {
+    std::ostringstream out;
+    out.imbue(std::locale::classic());
+    out.precision(precision);
+    out << value;
+    text = out.str();
+    std::istringstream in(text);
+    in.imbue(std::locale::classic());
+    double parsed = 0.0;
+    if ((in >> parsed) && parsed == value) {
+      break;
+    }
+  }
+  if (text.find_first_of(".eE") == std::string::npos) {
+    text += ".0";
+  }
+  return text;
+}
+
+bool IsBareConfigKey(std::string_view key) {
+  return !key.empty() && std::all_of(key.begin(), key.end(), [](char c) {
+    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
+           c == '_' || c == '-';
+  });
+}
+
+// toml++ prints floats through std::to_chars only where it trusts the
+// standard library; under Clang it falls back to a stream at max_digits10, so
+// every save rewrote 0.1 as 0.10000000000000001 across the whole file. A flat
+// file (every cvar config) is written key by key here instead: floats as
+// FormatConfigDouble, everything else through toml++'s own formatter.
+void WriteConfigTable(std::ostream& out, const toml::table& config) {
+  for (auto&& [key, node] : config) {
+    if (!IsBareConfigKey(key.str()) || node.is_table() || node.is_array()) {
+      out << config;  // nested layouts keep toml++'s formatting
+      return;
+    }
+  }
+  for (auto&& [key, node] : config) {
+    out << key.str() << " = ";
+    if (const auto* value = node.as_floating_point()) {
+      out << FormatConfigDouble(value->get());
+    } else {
+      out << toml::toml_formatter{node};
+    }
+    out << '\n';
+  }
+}
+
